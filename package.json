{
  "name": "d-j-view",
  "version": "0.1.0",
  "private": true,
  "description": "Capture public website frontends, discover browser-loaded assets, create portable ZIPs and verify local dependencies.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "capture": "node mirror.mjs",
    "benchmark": "node benchmark.mjs",
    "start": "node preview.mjs",
    "verify": "node verify.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.integration.mjs",
    "check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nuel-osas/D-j-View.git"
  }
}
